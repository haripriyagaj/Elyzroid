<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config for debug builds only -->
    <debug-overrides>
        <trust-anchors>
            <!-- Trust user-added CAs for development -->
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Allow cleartext traffic for Ngrok URLs in debug builds only -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ngrok-free.dev</domain>
        <domain includeSubdomains="true">ngrok.io</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
